# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Each phase adds the variables it needs here.

# --- General -------------------------------------------------------------
# Environment label stamped on metrics and logs: local | aws
ENVIRONMENT=local

# --- Floci (local AWS emulator) -----------------------------------------
# Host port Floci is published on. Bound to 127.0.0.1 only.
FLOCI_PORT=4566
# memory = lost on restart; persistent = flushed to the floci-data volume on every write
FLOCI_STORAGE_MODE=persistent
# Region used by the local AWS CLI and Terraform containers.
# The containers always use fake credentials (test/test) and the Floci
# endpoint; they never read ~/.aws, so they cannot reach real AWS.
AWS_REGION=ap-south-1

# --- E-commerce API (http://127.0.0.1:8080) ----------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL (internal only, not published) --------------------------------
# All three are required; generate each with: openssl rand -hex 24
# Hex keeps them safe in connection URLs. Applied only when the postgres-data
# volume is first created (database/init/01-ecommerce.sh).
POSTGRES_PASSWORD=
# Owner role: used only by the one-shot ecommerce-migrate job (can change schema).
ECOMMERCE_OWNER_PASSWORD=
# Runtime role: used by the API (row access only; cannot create/alter/drop/delete).
ECOMMERCE_APP_PASSWORD=

# --- Redis (internal only, cache) ----------------------------------------------
# Required; generate with: openssl rand -hex 24
# Use hex: the value is written into a redis config line, so spaces or quotes break it.
REDIS_PASSWORD=

# --- Prometheus -------------------------------------------------------------
# Data is deleted when EITHER limit is hit.
PROMETHEUS_RETENTION_TIME=3d
PROMETHEUS_RETENTION_SIZE=5GB

# --- cAdvisor ---------------------------------------------------------------
# containerd socket cAdvisor uses to find Docker containers.
# OrbStack: /var/run/docker/containerd/containerd.sock (default)
# Ubuntu/EC2 with docker-ce: /run/containerd/containerd.sock
CADVISOR_CONTAINERD_SOCKET=/var/run/docker/containerd/containerd.sock

# --- Grafana (http://127.0.0.1:3000) -----------------------------------------
GRAFANA_ADMIN_USER=admin
# Required; compose refuses to start without it. Generate one with: openssl rand -base64 18
# Only applied on Grafana's first start; to change it later see README "Known local limitations".
GRAFANA_ADMIN_PASSWORD=
