# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Each phase adds the variables it needs here.

# --- General -------------------------------------------------------------
# Environment label stamped on metrics and logs: local | aws
ENVIRONMENT=local

# --- Floci (local AWS emulator) -----------------------------------------
# Host port Floci is published on. Bound to 127.0.0.1 only.
FLOCI_PORT=4566
# memory = lost on restart; persistent = flushed to the floci-data volume on every write
FLOCI_STORAGE_MODE=persistent
# Region used by the local AWS CLI and Terraform containers.
# The containers always use fake credentials (test/test) and the Floci
# endpoint; they never read ~/.aws, so they cannot reach real AWS.
AWS_REGION=ap-south-1

# --- Real AWS (make aws-*) --------------------------------------------------
# 12-digit account the deploy targets must hit; every make aws-* target and Terraform's
# allowed_account_ids refuse any other. Credentials are NOT here: they live in
# ~/.aws/credentials under profile "cop" (IAM user cop-deployer, policy
# infrastructure/iam/deployer-policy.json), mounted read-only into aws-real/terraform-aws only.
AWS_ACCOUNT_ID=

# --- E-commerce API (http://127.0.0.1:8080) ----------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL (internal only, not published) --------------------------------
# All three are required; generate each with: openssl rand -hex 24
# Hex keeps them safe in connection URLs. Applied only when the postgres-data
# volume is first created (database/init/01-ecommerce.sh).
POSTGRES_PASSWORD=
# Owner role: used only by the one-shot ecommerce-migrate job (can change schema).
ECOMMERCE_OWNER_PASSWORD=
# Runtime role: used by the API (row access only; cannot create/alter/drop/delete).
ECOMMERCE_APP_PASSWORD=

# --- Incident management (API http://127.0.0.1:8081) ----------------------------
# All four are required; generate each with: openssl rand -hex 24
# Superuser of the separate incident-db Postgres. Like the passwords above, the three
# database passwords apply only when the incident-db-data volume is first created
# (database/incident-init/01-incident.sh).
INCIDENT_DB_PASSWORD=
# Owner role: used only by the one-shot incident-migrate job.
INCIDENT_OWNER_PASSWORD=
# Runtime role of the incident API (row access; cannot change schema or delete).
INCIDENT_APP_PASSWORD=
# Bearer token for every write to the incident API: Alertmanager's webhook and
# acknowledge/resolve/notes calls. At least 32 characters.
INCIDENT_API_TOKEN=

# --- Redis (internal only, cache) ----------------------------------------------
# Required; generate with: openssl rand -hex 24
# Use hex: the value is written into a redis config line, so spaces or quotes break it.
REDIS_PASSWORD=

# --- Prometheus -------------------------------------------------------------
# Data is deleted when EITHER limit is hit. SLOs are measured over 30 days, so keep
# at least 30d (about 30 MB/day locally).
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=5GB

# --- Alerting (Alertmanager http://127.0.0.1:9093) ----------------------------------
# All optional. Left empty, email goes to the local Mailpit inbox
# (http://127.0.0.1:8025) and Slack messages to the alert-sink container
# (docker compose logs alert-sink). Critical alerts: email + Slack; warnings: Slack.
# Both also go to the incident API's webhook.
# Values are written into Alertmanager's YAML inside double quotes, so they must
# not contain " or \. Changes apply on `make up`.
# SMTP server as host:port, e.g. smtp.gmail.com:587 (Gmail needs an app password).
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=
# true for real SMTP servers (STARTTLS); Mailpit (the default) has no TLS.
SMTP_REQUIRE_TLS=
ALERT_EMAIL_TO=
# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks); it
# decides the channel.
SLACK_WEBHOOK_URL=
# Base URLs that links in notifications point to (where a human reaches the UIs).
# Default to the local ports; set them when the UIs are reached another way.
PROMETHEUS_EXTERNAL_URL=
ALERTMANAGER_EXTERNAL_URL=

# --- cAdvisor ---------------------------------------------------------------
# containerd socket cAdvisor uses to find Docker containers.
# OrbStack: /var/run/docker/containerd/containerd.sock (default)
# Ubuntu/EC2 with docker-ce: /run/containerd/containerd.sock
CADVISOR_CONTAINERD_SOCKET=/var/run/docker/containerd/containerd.sock

# --- Grafana (http://127.0.0.1:3000) -----------------------------------------
GRAFANA_ADMIN_USER=admin
# Required; compose refuses to start without it. Generate one with: openssl rand -base64 18
# Only applied on Grafana's first start; to change it later see README "Known local limitations".
GRAFANA_ADMIN_PASSWORD=
