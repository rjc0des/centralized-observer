{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsAwsEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:rjc0des@47665982/centralized-observer@1442905418:environment:aws"
        }
      }
    }
  ]
}
